{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JP animations file",
  "type": "object",
  "required": [
    "version",
    "count",
    "animations"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "count": {
      "type": "integer"
    },
    "animations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "questionId",
          "stepSeconds",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "questionId": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "calculation",
              "concept"
            ],
            "description": "Optional lesson style. Defaults to calculation when omitted."
          },
          "stepSeconds": {
            "type": "number"
          },
          "steps": {
            "$ref": "#/$defs/stepList"
          },
          "teach": {
            "$ref": "#/$defs/stepList",
            "description": "Optional expanded teaching-style steps shown in Teach me mode."
          }
        }
      }
    }
  },
  "$defs": {
    "stepList": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "n",
          "display",
          "tag",
          "narration"
        ],
        "additionalProperties": false,
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "display": {
            "type": "string",
            "description": "What is handwritten on the paper. May contain subscripts and symbols."
          },
          "tag": {
            "type": "string",
            "description": "Small label beside the line"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Optional numbered bold heading saying what is done in this step. Falls back to tag when omitted."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Optional one-sentence plain reason explaining what we do and why. May include maths notation."
          },
          "working": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Optional compact list of side-working lines for small sums. May include maths notation."
          },
          "narration": {
            "type": "string",
            "description": "Spoken line and caption. Written as words, never symbols, so a voice can read it."
          }
        }
      }
    }
  }
}
